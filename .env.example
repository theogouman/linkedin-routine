# ════════════════════════════════════════════════════════════════════════════
# Variables d'environnement — copier en .env.local (dev) ou dans Vercel (prod).
# Aucune valeur par défaut n'est un secret : tout ce qui est sensible doit être
# généré, jamais repris d'ici.
# ════════════════════════════════════════════════════════════════════════════

# ── Authentification de l'app (FR-015) ──────────────────────────────────────
# Génère le hash : node scripts/hash-password.mjs "ton mot de passe"
APP_PASSWORD_HASH=
# Secret de signature du cookie de session — 32 octets aléatoires :
#   openssl rand -base64 32
SESSION_SECRET=

# ── Base de données (Supabase Postgres) ─────────────────────────────────────
# La service role key n'est JAMAIS exposée au navigateur : tout l'accès données
# passe par le serveur, derrière le cookie de session.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Récupération — Apify, actors no-cookie (FR-021) ─────────────────────────
APIFY_TOKEN=
# Actors par défaut si non renseignés (format `user~actor`) :
#   harvestapi~linkedin-profile-posts   (~0,002 $ / post)
#   harvestapi~linkedin-post-comments   (~0,002 $ / commentaire)
APIFY_POSTS_ACTOR=harvestapi~linkedin-profile-posts
APIFY_COMMENTS_ACTOR=harvestapi~linkedin-post-comments
# Optionnel : enrichissement des profils à l'ajout. Sans lui, nom et photo sont
# déduits de la première publication récupérée.
APIFY_PROFILE_ACTOR=
# `fake` = fournisseur en mémoire, pour développer sans compte ni budget.
INGESTION_PROVIDER=apify

# ── Écriture — Unipile, seul point qui engage le compte LinkedIn ────────────
UNIPILE_DSN=
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=
# `fake` = n'envoie rien, enregistre les appels. À utiliser en développement.
WRITE_PROVIDER=unipile

# ── Génération IA (FR-019) ──────────────────────────────────────────────────
# Clé d'API DÉDIÉE. Ne jamais utiliser le jeton d'abonnement Claude
# (OAuth Claude Code / claude.ai) : c'est contraire aux conditions
# d'utilisation d'Anthropic et cela exposerait le compte.
ANTHROPIC_API_KEY=
# Le modèle et l'effort SE RÈGLENT DANS L'APP (File ▸ Réglages ▸ Génération).
# Valeurs de départ uniquement, comme les réglages de récupération plus bas.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low               # low | medium | high | xhigh | max

# ── Notifications push (FR-014) ─────────────────────────────────────────────
# Génère la paire : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@exemple.fr

# ── Ordonnanceur ────────────────────────────────────────────────────────────
# Secret partagé des routes /api/cron/*. Sans lui, elles répondent 503.
CRON_SECRET=

# ── Réglages de récupération — SE RÈGLENT DANS L'APP ────────────────────────
# Ces six réglages vivent en base et se modifient depuis le téléphone :
#   • le fuseau dans File ▸ Réglages ▸ Fuseau horaire
#   • les cinq autres dans File ▸ Réglages ▸ Récupération
# Les laisser vides est le cas normal. Les variables ci-dessous ne servent que
# de valeurs de DÉPART, lues tant qu'aucun réglage n'a été enregistré depuis
# l'app ; après le premier enregistrement, la base prime définitivement et
# changer une de ces variables n'a plus aucun effet.
#
# APP_TIMEZONE=Europe/Paris          # fuseau des plafonds et de la fenêtre
# INITIAL_BACKFILL_DAYS=7            # profondeur du 1er passage sur un compte
# RECEIVED_COMMENTS_WINDOW_DAYS=30   # fenêtre glissante des comm. reçus
# MAX_LOOKBACK_DAYS=90               # plafond de rattrapage après une absence
# MAX_POSTS_PER_ACCOUNT=20           # garde-fou de coût, par appel
# MAX_COMMENTS_PER_POST=50           # garde-fou de coût, par appel
